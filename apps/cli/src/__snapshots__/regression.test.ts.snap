exports[`Regression Snapshot Test Harness > Golden Snapshot: Polyglot Monorepo (Node + Python + Docker) 1`] = `
"# ==============================================================================
# Generated by Auto GitHub Actions (auto-gha)
# Workflow: Node.js CI, Python CI, Docker Build, Publish Docker Image (GHCR) (4 jobs)
# Configuration: Parallel DAG | Dependency Caching: Enabled | Production Hardening: Enabled
# ==============================================================================

name: CI/CD Pipeline
on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
permissions:
  contents: read
concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }}
  cancel-in-progress: true
jobs:
  test-node:
    name: Node.js CI
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20.x
          cache: npm
          cache-dependency-path: "**/package-lock.json"
  test-python:
    name: Python CI
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: 3.x
          cache: pip
          cache-dependency-path: "**/requirements.txt"
      - run: python -m pip install --upgrade pip pytest && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi && for req in $(find . -name 'requirements.txt' -not -path '*/.*' -not -path './requirements.txt'); do pip install -r "$req"; done
      - run: pytest || [ $? -eq 5 ]
  build-docker:
    name: Docker Build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    needs:
      - test-node
      - test-python
    steps:
      - uses: actions/checkout@v4
      - uses: docker/build-push-action@v6
        with:
          push: false
          file: Dockerfile
          context: .
  deploy-ghcr:
    name: Publish Docker Image (GHCR)
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    timeout-minutes: 15
    needs:
      - test-node
      - test-python
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - uses: docker/metadata-action@v5
        with:
          images: ghcr.io/\${{ github.repository }}
      - uses: docker/build-push-action@v6
        with:
          push: true
          tags: \${{ steps.ghcr-meta.outputs.tags }}
          labels: \${{ steps.ghcr-meta.outputs.labels }}
          file: Dockerfile
          context: .
"
`;

