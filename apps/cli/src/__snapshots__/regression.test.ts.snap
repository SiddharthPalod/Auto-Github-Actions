exports[`Regression Snapshot Test Harness > Golden Snapshot: Single-Stack Python with pytest 1`] = `
"# ==============================================================================
# Generated by Auto GitHub Actions (auto-gha)
# Workflow: Python CI (1 job)
# Configuration: Parallel DAG | Dependency Caching: Enabled | Production Hardening: Enabled
# ==============================================================================

name: CI/CD Pipeline
on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
permissions:
  contents: read
concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }}
  cancel-in-progress: true
jobs:
  test-python:
    name: Python CI
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: 3.x
          cache: pip
      - run: python -m pip install --upgrade pip pytest && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi && for req in $(find . -name 'requirements.txt' -not -path '*/.*' -not -path './requirements.txt'); do pip install -r "$req"; done
      - run: pytest || [ $? -eq 5 ]
"
`;

exports[`Regression Snapshot Test Harness > Golden Snapshot: Single-Stack Rust 1`] = `
"# ==============================================================================
# Generated by Auto GitHub Actions (auto-gha)
# Workflow: Rust CI (1 job)
# Configuration: Parallel DAG | Dependency Caching: Enabled | Production Hardening: Enabled
# ==============================================================================

name: CI/CD Pipeline
on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
permissions:
  contents: read
concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }}
  cancel-in-progress: true
jobs:
  test-rust:
    name: Rust CI
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Cache Rust Dependencies
        uses: actions/cache@v4
        with:
          path: |-
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: \${{ runner.os }}-cargo-\${{ hashFiles('**/Cargo.lock') }}
          restore-keys: \${{ runner.os }}-cargo-
      - run: if [ -f Cargo.toml ]; then cargo build --verbose; else for toml in $(find . -name 'Cargo.toml' -not -path '*/.*' -not -path '*/target/*'); do (cd "$(dirname "$toml")" && echo "Building $(dirname "$toml")..." && cargo build --verbose); done; fi
      - run: if [ -f Cargo.toml ]; then cargo test --verbose; else for toml in $(find . -name 'Cargo.toml' -not -path '*/.*' -not -path '*/target/*'); do (cd "$(dirname "$toml")" && echo "Testing $(dirname "$toml")..." && cargo test --verbose); done; fi
"
`;

exports[`Regression Snapshot Test Harness > Golden Snapshot: Symfony PHP Framework 1`] = `
"# ==============================================================================
# Generated by Auto GitHub Actions (auto-gha)
# Workflow: PHP CI (1 job)
# Configuration: Parallel DAG | Dependency Caching: Enabled | Production Hardening: Enabled
# ==============================================================================

name: CI/CD Pipeline
on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
permissions:
  contents: read
concurrency:
  group: \${{ github.workflow }}-\${{ github.ref }}
  cancel-in-progress: true
jobs:
  test-php:
    name: PHP CI
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: shivammathur/setup-php@v2
        with:
          php-version: "8.2"
      - run: composer install -q --no-ansi --no-interaction --no-scripts --no-progress --prefer-dist && (vendor/bin/phpunit || [ $? -eq 0 ])
      - uses: shivammathur/setup-php@v2
        with:
          php: "8.3"
          extensions: mbstring, xml, ctype, iconv, intl, pdo_sqlite
          coverage: none
      - run: composer install --prefer-dist --no-progress
      - run: php bin/phpunit
"
`;
