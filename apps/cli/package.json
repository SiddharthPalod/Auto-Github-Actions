{
  "name": "auto-gha",
  "version": "1.0.9",
  "description": "Zero-configuration GitHub Actions workflow generator",
  "author": "Siddharth Palod",
  "license": "MIT",
  "homepage": "https://github.com/SiddharthPalod/Auto-Github-Actions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiddharthPalod/Auto-Github-Actions.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/SiddharthPalod/Auto-Github-Actions/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "github-actions",
    "ci",
    "cd",
    "generator",
    "automation",
    "devops",
    "zero-config",
    "security"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "auto-gha": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "SECURITY.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@auto-gha/compiler": "workspace:*",
    "@auto-gha/github": "workspace:*",
    "@auto-gha/planner": "workspace:*",
    "@auto-gha/reconciliation": "workspace:*",
    "@auto-gha/resolver": "workspace:*",
    "@auto-gha/scanner": "workspace:*",
    "@auto-gha/security": "workspace:*",
    "@auto-gha/state": "workspace:*",
    "@auto-gha/workflow-ir": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}